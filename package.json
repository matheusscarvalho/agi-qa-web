{
  "name": "agi-qa-web",
  "version": "1.0.0",
  "description": "Automacao de testes E2E da pesquisa de artigos do Blog do Agi",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:headed": "playwright test --project=chromium-desktop --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:security": "playwright test --grep @security",
    "test:exception": "playwright test --grep @exception",
    "test:altflow": "playwright test --grep @altflow",
    "test:lupa": "playwright test --grep @lupa",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0"
  },
  "private": true
}
